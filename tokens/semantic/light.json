{
  "$description": "Semantic (role) color tokens for the light theme. Components should reference these — never core.color.* directly — so retheming or adding a theme never touches component code. Naming follows the shadcn/ui convention (background/foreground pairs) for drop-in familiarity.",
  "background": { "$value": "{palette.neutral.50}", "$type": "color" },
  "foreground": { "$value": "{palette.neutral.950}", "$type": "color" },
  "card": { "$value": "{color.white}", "$type": "color" },
  "card-foreground": { "$value": "{palette.neutral.950}", "$type": "color" },
  "popover": { "$value": "{color.white}", "$type": "color" },
  "popover-foreground": { "$value": "{palette.neutral.950}", "$type": "color" },
  "primary": { "$value": "{palette.brand.700}", "$type": "color" },
  "primary-foreground": { "$value": "{color.white}", "$type": "color" },
  "secondary": { "$value": "{palette.neutral.100}", "$type": "color" },
  "secondary-foreground": { "$value": "{palette.neutral.900}", "$type": "color" },
  "muted": { "$value": "{palette.neutral.100}", "$type": "color" },
  "muted-foreground": { "$value": "{palette.neutral.600}", "$type": "color" },
  "accent": { "$value": "{palette.accent.100}", "$type": "color" },
  "accent-foreground": { "$value": "{palette.accent.900}", "$type": "color" },
  "destructive": { "$value": "{color.danger.600}", "$type": "color" },
  "destructive-foreground": { "$value": "{color.white}", "$type": "color" },
  "success": { "$value": "{color.success.700}", "$type": "color" },
  "success-foreground": { "$value": "{color.white}", "$type": "color" },
  "warning": { "$value": "{color.warning.500}", "$type": "color" },
  "warning-foreground": { "$value": "{palette.neutral.950}", "$type": "color" },
  "info": { "$value": "{color.info.600}", "$type": "color" },
  "info-foreground": { "$value": "{color.white}", "$type": "color" },
  "border": { "$value": "{palette.neutral.200}", "$type": "color" },
  "input": { "$value": "{palette.neutral.200}", "$type": "color" },
  "ring": { "$value": "{palette.brand.600}", "$type": "color" },
  "sidebar": { "$value": "{palette.neutral.100}", "$type": "color" },
  "sidebar-foreground": { "$value": "{palette.neutral.950}", "$type": "color" },
  "sidebar-primary": { "$value": "{palette.brand.700}", "$type": "color" },
  "sidebar-primary-foreground": { "$value": "{color.white}", "$type": "color" },
  "sidebar-accent": { "$value": "{palette.neutral.200}", "$type": "color" },
  "sidebar-accent-foreground": { "$value": "{palette.neutral.900}", "$type": "color" },
  "sidebar-border": { "$value": "{palette.neutral.200}", "$type": "color" },
  "sidebar-ring": { "$value": "{palette.brand.600}", "$type": "color" }
}
