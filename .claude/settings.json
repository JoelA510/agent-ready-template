{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(npm install*--force*)",
      "Bash(npm install*--legacy-peer-deps*)",
      "Bash(npm i *--force*)",
      "Bash(npm i *--legacy-peer-deps*)",
      "Bash(npm ci*--force*)",
      "Bash(npm ci*--legacy-peer-deps*)",
      "PowerShell(npm install*--force*)",
      "PowerShell(npm install*--legacy-peer-deps*)",
      "PowerShell(npm i *--force*)",
      "PowerShell(npm i *--legacy-peer-deps*)",
      "PowerShell(npm ci*--force*)",
      "PowerShell(npm ci*--legacy-peer-deps*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/guard-generated.mjs\""
          }
        ]
      }
    ]
  }
}
