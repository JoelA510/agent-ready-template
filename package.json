{
  "name": "@acme/design-system",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://joela510.github.io/agent-ready-template/",
  "type": "module",
  "description": "A project build template: prompts for taking a codebase to production standards, design tokens, accessible React components, and written brand & content guidelines. Fork it and swap in your brand.",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --noEmit",
    "check": "npm run tokens:build && npm run check-contrast && npm run typecheck && npm run lint && npm run check:unused && npm run build && npm run check:bundle && npm run build-storybook && npm run test",
    "check-contrast": "node scripts/check-contrast.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "check:audit": "node scripts/check-audit.mjs",
    "check:env": "node scripts/check-env.mjs",
    "check:instructions": "node scripts/check-instructions.mjs",
    "check:conformance": "node scripts/check-conformance.mjs",
    "check:settings": "node scripts/check-settings.mjs",
    "check:upgrade-path": "node scripts/check-upgrade-path.mjs",
    "check:unused": "knip",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "fleet:report": "node scripts/fleet-report.mjs",
    "fleet:update": "node scripts/fleet-update.mjs",
    "test": "vitest run",
    "pretest:browser": "npm run tokens:build",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest",
    "tokens:build": "node style-dictionary.config.mjs",
    "tokens:watch": "node --watch style-dictionary.config.mjs",
    "registry:build": "node scripts/build-registry.mjs",
    "skills:build": "node scripts/build-skills.mjs",
    "init": "node scripts/init.mjs",
    "process:apply": "node scripts/apply-process.mjs",
    "prepare": "husky || true",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "predev": "npm run tokens:build",
    "prebuild": "npm run tokens:build",
    "prestorybook": "npm run tokens:build",
    "prebuild-storybook": "npm run tokens:build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.2.21",
    "@radix-ui/react-alert-dialog": "^1.1.24",
    "@radix-ui/react-aspect-ratio": "^1.1.16",
    "@radix-ui/react-avatar": "^1.2.7",
    "@radix-ui/react-checkbox": "^1.3.12",
    "@radix-ui/react-collapsible": "^1.1.17",
    "@radix-ui/react-context-menu": "^2.3.8",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-hover-card": "^1.1.24",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-menubar": "^1.1.25",
    "@radix-ui/react-navigation-menu": "^1.3.0",
    "@radix-ui/react-popover": "^1.2.0",
    "@radix-ui/react-progress": "^1.1.17",
    "@radix-ui/react-radio-group": "^1.4.8",
    "@radix-ui/react-scroll-area": "^1.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-separator": "^1.1.16",
    "@radix-ui/react-slider": "^1.5.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-toggle": "^1.1.15",
    "@radix-ui/react-toggle-group": "^1.1.20",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tanstack/react-table": "^9.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^4.14.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/almarai": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-links": "^10.6.1",
    "@storybook/addon-themes": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/react": "^10.5.3",
    "@storybook/react-vite": "^10.6.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.2",
    "json5": "^2.2.3",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "playwright": "^1.63.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.9.0",
    "storybook": "^10.6.2",
    "storybook-design-token": "^5.0.0",
    "style-dictionary": "^5.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.6"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": "eslint --fix --max-warnings=0 --no-warn-ignored"
  }
}
