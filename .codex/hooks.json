{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/guard-generated.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking for generated files"
          }
        ]
      }
    ]
  }
}
