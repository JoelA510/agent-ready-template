{
  "guard-generated": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/guard-generated.mjs\" --agent antigravity",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
