{
  "$description": "Plumb preset (ADR 0021), light theme: the template's semantic roles, valued from Plumb's roles in tokens/core/color.json (plumb.light.*). The role names are the template's; only the values are Plumb's.",
  "background": { "$value": "{plumb.light.canvas}", "$type": "color" },
  "foreground": { "$value": "{plumb.light.ink}", "$type": "color" },
  "card": { "$value": "{plumb.light.surface}", "$type": "color" },
  "card-foreground": { "$value": "{plumb.light.ink}", "$type": "color" },
  "popover": { "$value": "{plumb.light.raised}", "$type": "color" },
  "popover-foreground": { "$value": "{plumb.light.ink}", "$type": "color" },
  "primary": { "$value": "{plumb.light.accent}", "$type": "color" },
  "primary-foreground": { "$value": "{plumb.light.on-accent}", "$type": "color" },
  "secondary": { "$value": "{plumb.light.sunken}", "$type": "color" },
  "secondary-foreground": { "$value": "{plumb.light.ink}", "$type": "color" },
  "muted": { "$value": "{plumb.light.sunken}", "$type": "color" },
  "muted-foreground": { "$value": "{plumb.light.ink-soft}", "$type": "color" },
  "accent": { "$value": "{plumb.light.accent-soft}", "$type": "color" },
  "accent-foreground": { "$value": "{plumb.light.accent-ink}", "$type": "color" },
  "destructive": { "$value": "{plumb.light.block}", "$type": "color" },
  "destructive-foreground": { "$value": "{plumb.light.on-block}", "$type": "color" },
  "success": { "$value": "{plumb.light.pass-ink}", "$type": "color" },
  "success-foreground": { "$value": "{color.white}", "$type": "color" },
  "warning": { "$value": "{plumb.light.warn-ink}", "$type": "color" },
  "warning-foreground": { "$value": "{color.white}", "$type": "color" },
  "info": { "$value": "{plumb.light.ink-soft}", "$type": "color" },
  "info-foreground": { "$value": "{plumb.light.canvas}", "$type": "color" },
  "border": { "$value": "{plumb.light.line}", "$type": "color" },
  "input": { "$value": "{plumb.light.border-control}", "$type": "color" },
  "ring": { "$value": "{plumb.light.accent}", "$type": "color" },
  "sidebar": { "$value": "{plumb.light.surface}", "$type": "color" },
  "sidebar-foreground": { "$value": "{plumb.light.ink}", "$type": "color" },
  "sidebar-primary": { "$value": "{plumb.light.accent}", "$type": "color" },
  "sidebar-primary-foreground": { "$value": "{plumb.light.on-accent}", "$type": "color" },
  "sidebar-accent": { "$value": "{plumb.light.hover}", "$type": "color" },
  "sidebar-accent-foreground": { "$value": "{plumb.light.ink}", "$type": "color" },
  "sidebar-border": { "$value": "{plumb.light.line}", "$type": "color" },
  "sidebar-ring": { "$value": "{plumb.light.accent}", "$type": "color" }
}
