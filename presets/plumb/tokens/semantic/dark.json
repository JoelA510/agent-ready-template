{
  "$description": "Plumb preset (ADR 0021), dark theme: the template's semantic roles, valued from Plumb's roles in tokens/core/color.json (plumb.dark.*). The role names are the template's; only the values are Plumb's.",
  "background": { "$value": "{plumb.dark.canvas}", "$type": "color" },
  "foreground": { "$value": "{plumb.dark.ink}", "$type": "color" },
  "card": { "$value": "{plumb.dark.surface}", "$type": "color" },
  "card-foreground": { "$value": "{plumb.dark.ink}", "$type": "color" },
  "popover": { "$value": "{plumb.dark.raised}", "$type": "color" },
  "popover-foreground": { "$value": "{plumb.dark.ink}", "$type": "color" },
  "primary": { "$value": "{plumb.dark.accent}", "$type": "color" },
  "primary-foreground": { "$value": "{plumb.dark.on-accent}", "$type": "color" },
  "secondary": { "$value": "{plumb.dark.sunken}", "$type": "color" },
  "secondary-foreground": { "$value": "{plumb.dark.ink}", "$type": "color" },
  "muted": { "$value": "{plumb.dark.sunken}", "$type": "color" },
  "muted-foreground": { "$value": "{plumb.dark.ink-soft}", "$type": "color" },
  "accent": { "$value": "{plumb.dark.accent-soft}", "$type": "color" },
