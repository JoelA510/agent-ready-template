  "info": { "$value": "{plumb.dark.ink-soft}", "$type": "color" },
  "info-foreground": { "$value": "{plumb.dark.canvas}", "$type": "color" },
  "border": { "$value": "{plumb.dark.line}", "$type": "color" },
  "input": { "$value": "{plumb.dark.border-control}", "$type": "color" },
  "ring": { "$value": "{plumb.dark.accent}", "$type": "color" },
