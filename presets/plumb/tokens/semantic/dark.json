  "sidebar-accent": { "$value": "{plumb.dark.hover}", "$type": "color" },
  "sidebar-accent-foreground": { "$value": "{plumb.dark.ink}", "$type": "color" },
  "sidebar-border": { "$value": "{plumb.dark.line}", "$type": "color" },
  "sidebar-ring": { "$value": "{plumb.dark.accent}", "$type": "color" }
}
