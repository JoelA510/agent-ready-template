# Install guards, read by the npm package.json pins (npm 11.15 or later). Why: ADR 0019.

# Choose only releases at least 7 days old, the same wait Dependabot keeps. It applies when npm
# picks a version (npm install, npm update), not to npm ci, which installs the lockfile as it is.
# To take an urgent fix younger than that: npm install <pkg>@<version> --min-release-age=0.
min-release-age=7

# A git dependency, or a tarball from a URL, only where package.json itself names one: never one
# a dependency brings in. A git dependency is the route TanStack's compromised packages used (May
# 2026). Tarballs from the registry aren't affected.
allow-git=root
allow-remote=root
